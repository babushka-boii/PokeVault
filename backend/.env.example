APP_ENV=development
# Keep these databases separate. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://pokevault:replace-me@localhost:5432/pokevault
POKEVAULT_TEST_DATABASE_URL=postgresql+psycopg://pokevault:replace-me@localhost:5432/pokevault_test
CORS_ORIGINS=http://localhost:5173

# Google Auth platform > Clients > Web application. Leave blank until configured.
# Secrets belong only in the ignored backend/.env, never in frontend variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_ORIGIN=http://localhost:5173
# HTTP localhost development only. HTTPS deployments MUST set true.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=604800
AUTH_TRANSACTION_TTL_SECONDS=600
